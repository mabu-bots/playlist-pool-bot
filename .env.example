# Discord 開発者ポータルで作成した Bot のトークン (必須)
DISCORD_TOKEN=
# アプリケーション (Bot) のクライアント ID (必須)
CLIENT_ID=
# 任意: 設定すると、そのサーバーにだけコマンドを即時登録する (開発用)
GUILD_ID=
# 任意: 状態ファイルのパス (既定 data/state.json)
STATE_PATH=

# ---- Spotify 連携 (任意) ----
# 4 つすべてを設定すると /export が Spotify プレイリストへ直接曲を追加する。
# 1 つでも欠けている場合は、検索リンク付きリストを投稿するフォールバックになる。
# 取得手順は README.md を参照。
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REFRESH_TOKEN=
SPOTIFY_PLAYLIST_ID=

# ---- 生成物のサーバー保存 (任意) ----
# /export が生成した Markdown をサーバー内に保存する機能。
# 止める場合は off、保存先を変える場合はパスを指定する (既定 data/archive)。
# PRODUCT_ARCHIVE=off
# PRODUCT_ARCHIVE_DIR=data/archive
